{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "runtime.pathStrict": true,
  "workspace.library": [
    "/games/steamapps/common/ProjectZomboid/media/lua/shared",
    "/games/steamapps/common/ProjectZomboid/media/lua/client",
    "/games/steamapps/common/ProjectZomboid/media/lua/server"
  ],
  "workspace.checkThirdParty": false,
  "workspace.ignoreDir": [
    "node_modules",
    "dist",
    "build",
    ".git"
  ],
  "diagnostics.globals": [
    "instanceof",
    "getPlayer",
    "getSpecificPlayer",
    "getCore",
    "getWorld",
    "getCell",
    "getGameTime",
    "getClimateManager",
    "getText",
    "getTextOrNull",
    "getTimestampMs",
    "getFileWriter",
    "getFileReader",
    "getFileSeparator",
    "getMyDocumentFolder",
    "getModInfoByID",
    "getActivatedMods",
    "getSandboxOptions",
    "isClient",
    "isServer",
    "transformIntoKahluaTable",
    "Events",
    "Core",
    "Clipboard",
    "CharacterStat",
    "CharacterTrait",
    "CharacterTraitDefinition",
    "PerkFactory",
    "Perks",
    "PerkList",
    "SafeHouse",
    "MapItem",
    "UIWorldMap",
    "WorldMapVisited",
    "InventoryItem",
    "InventoryItemFactory",
    "ItemTag",
    "MoodleType",
    "BodyPartType",
    "IsoPlayer",
    "IsoGridSquare",
    "IsoObject",
    "IsoWorld",
    "ZombRand",
    "ZombRandFloat",
    "ArrayList",
    "PZAPI",
    "SandboxVars",
    "ModData",
    "Translator"
  ],
  "diagnostics.disable": [
    "lowercase-global",
    "duplicate-set-field"
  ],
  "format.enable": false
}
