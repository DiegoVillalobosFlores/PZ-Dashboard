# Copy to .env (gitignored) and fill in real values.

# Master key Penpot derives session/invitation keys from. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=

# MCP key generated from Your account > Integrations > MCP Server inside
# Penpot (http://localhost:9001). Only needed by pcall.sh, not by
# docker-compose itself.
PENPOT_MCP_TOKEN=

# Login for the local account used to drive the design file. Not needed by
# docker-compose; recorded here so it doesn't only live in chat history.
PENPOT_ACCOUNT_EMAIL=
PENPOT_ACCOUNT_PASSWORD=
