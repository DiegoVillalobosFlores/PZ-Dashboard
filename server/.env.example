# Directory the Project Zomboid mod writes JSON snapshots into.
# Defaults to ~/Zomboid/Lua, which is where getFileWriter() lands on
# Linux/macOS. On Windows this is typically %UserProfile%\Zomboid\Lua.
PZ_LUA_DIR=

# Port the dashboard server listens on.
PORT=3000

# The Project Zomboid game install directory (not the Zomboid data dir
# above) - where media/maps/<Region>/spawnSelectImagePyramid.zip lives.
# Needed for the /api/map/* tile endpoints. No sane default across
# native/Proton/Windows installs, so this must be set explicitly.
PZ_INSTALL_DIR=
